# Copy to .env. Leave unused providers blank; never commit real credentials.
PUBLIC_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
ADMIN_NAME=Admin
ADMIN_EMAILS=
# When blank, strong secrets are generated and stored in DATA_DIR.
ADMIN_TOKEN=
AUTH_SECRET=

# Public repository imports (optional token for GitHub API rate limits).
GITHUB_IMPORT_TOKEN=

# Optional: AI name suggestions on the wallpaper page (sends the preview to the Claude API on click).
ANTHROPIC_API_KEY=

# Email magic links.
SMTP_URL=
SMTP_FROM=

# Callback: PUBLIC_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Callback: PUBLIC_URL/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple requires a real HTTPS domain, not localhost.
# Callback: PUBLIC_URL/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
# Optional alternative to generating a JWT from the private key:
APPLE_CLIENT_SECRET=
